{{- $status := default "available" (index .Request.Query "status") -}}
{{- $trace := trunc 10 (sha256sum (printf "%s|%s" .Request.Path $status)) -}}
{{- $pets := list
  (dict
    "id" 101
    "name" (printf "Retriever-%s" (trunc 4 $trace))
    "photoUrls" (list "https://example.com/pets/101/front.jpg")
    "status" "available")
  (dict
    "id" 102
    "name" (printf "Spaniel-%s" (trunc 4 (sha1sum $trace)))
    "photoUrls" (list "https://example.com/pets/102/front.jpg")
    "status" "available")
-}}
{{ mustToPrettyJSON $pets }}
