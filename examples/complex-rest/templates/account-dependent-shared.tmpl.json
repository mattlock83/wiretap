{{- $toAccountID := trimPrefix "/accounts/" .Request.Path -}}
{{- $fromAccountID := mustGetVar "payment_from_account_id" -}}
{{- $currency := mustGetVar "payment_currency" -}}
{{- $profileName := mustGetVar "payment_profile_name" -}}
{{- $profileEmail := mustGetVar "payment_profile_email" -}}
{{- $riskSeed := mustGetVar "payment_risk_seed" -}}
{{- $openedAt := mustGetVar "payment_opened_at" -}}
{{- $fromAliasName := mustGetVar "payment_alias_name" -}}
{{- $counterpartyName := printf "Counterparty for %s (%s)" $fromAccountID $profileName -}}
{{- $balance := add 450 (len (toString $riskSeed)) -}}
{{- $labels := list (printf "from:%s" $fromAccountID) (printf "risk:%s" $riskSeed) (printf "contact:%s" $profileEmail) -}}
{{- $derived := mustFromJSON (mustToJSON (dict "labels" $labels "opened_at" $openedAt "alias" $fromAliasName "path" (cel "path"))) -}}
{{- $derivedHash := trunc 8 (sha1sum (mustToJSON $derived)) -}}
{
  "id": "{{ $toAccountID }}",
  "name": "{{ printf "%s [%s]" $counterpartyName $derivedHash }}",
  "balance": {{ $balance }},
  "currency": "{{ $currency }}",
  "status": "active"
}
