{{- $accountID := trimPrefix "/accounts/" .Request.Path -}}
{{- $profileName := Name -}}
{{- $profileEmail := Email -}}
{{- $currency := "USD" -}}
{{- $baseBalance := 1800 -}}
{{- $riskSeed := trunc 12 (sha256sum (printf "%s|%s|%s" $accountID $profileName (formatTime "2006-01-02" (nowUTC)))) -}}
{{- $openedAt := formatTime "2006-01-02T15:04:05Z07:00" (nowPlus "-72h") -}}
{{- setVar "payment_from_account_id" $accountID -}}
{{- setVar "payment_currency" $currency -}}
{{- setVar "payment_profile_name" $profileName -}}
{{- setVar "payment_profile_email" $profileEmail -}}
{{- setVar "payment_risk_seed" $riskSeed -}}
{{- setVar "payment_opened_at" $openedAt -}}
{{- $aliasName := printf "%s-%s-%s" (trunc 8 $profileName) (upper (substr 0 3 $currency)) (trunc 5 $riskSeed) -}}
{{- setVar "payment_alias_name" $aliasName -}}
{
  "id": "{{ $accountID }}",
  "name": "{{ $aliasName }}",
  "balance": {{ $baseBalance }},
  "currency": "{{ $currency }}",
  "status": "active"
}
