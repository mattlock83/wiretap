{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle-evidence.schema.json",
  "title": "Wiretap bundle format 3.x",
  "oneOf": [
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/attempt"
    }
  ],
  "$defs": {
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "wiretap"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "testIdentity": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "variant": {
          "type": "string"
        },
        "attempt_ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "providerRef": {
      "type": "object",
      "required": [
        "application_id",
        "api_id"
      ],
      "properties": {
        "application_id": {
          "type": "string",
          "minLength": 1
        },
        "api_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^3\\.[0-9]+$"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 0
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        ]
      }
    },
    "fileRef": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "schemaRef": {
      "type": "object",
      "required": [
        "id",
        "role",
        "type",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "sut",
            "provided",
            "dependency"
          ]
        },
        "type": {
          "const": "openapi"
        },
        "protocol": {
          "enum": [
            "",
            "http"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "file",
                "omitted"
              ]
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            },
            "format": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "openapi_version": {
          "type": "string"
        },
        "asset_id": {
          "type": "string"
        },
        "asset_name": {
          "type": "string"
        },
        "asset_sha": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "format_version",
        "required_capabilities",
        "run_id",
        "revision",
        "run_state",
        "started_at",
        "updated_at",
        "inventory_scope",
        "provided_apis",
        "dependencies",
        "tests"
      ],
      "properties": {
        "format_version": {
          "$ref": "#/$defs/version"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "provider_mappings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/providerRef"
          }
        },
        "required_capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "application": {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "pattern": "\\S"
                }
              }
            },
            {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "pattern": "\\S"
                }
              }
            }
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "inventory_scope": {
          "const": "configured_and_observed"
        },
        "provided_apis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/api"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/api"
          }
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "run_state": {
          "enum": [
            "open",
            "complete",
            "interrupted"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "api_id": {
          "type": "string"
        },
        "sut_target_kind": {
          "enum": [
            "mock",
            "service",
            "unknown"
          ]
        },
        "dependency_kinds": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "mock",
              "service",
              "unknown"
            ]
          }
        },
        "test_source": {
          "type": "object"
        },
        "sut_source": {
          "type": "object"
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schemaRef"
          }
        },
        "pending_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "attempt_id",
              "name",
              "started_at"
            ],
            "properties": {
              "identity": {
                "$ref": "#/$defs/testIdentity"
              },
              "attempt_id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "meta": {
                "type": "object"
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/fileRef"
              },
              {
                "type": "object",
                "required": [
                  "attempt_id"
                ],
                "properties": {
                  "attempt_id": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            ]
          }
        }
      },
      "not": {
        "required": [
          "contract_resolutions"
        ]
      }
    },
    "api": {
      "type": "object",
      "required": [
        "id",
        "target_kind",
        "configured",
        "protocols",
        "contracts",
        "observed_in"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target_kind": {
          "enum": [
            "mock",
            "service",
            "unknown"
          ]
        },
        "configured": {
          "type": "boolean"
        },
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "const": "http"
          }
        },
        "observed_in": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "openapi"
              },
              "source": {
                "$ref": "#/$defs/schemaRef/properties/source"
              }
            }
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "required": [
        "id",
        "protocol",
        "channel",
        "request",
        "response"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "enum": [
            "",
            "http"
          ]
        },
        "channel": {
          "type": "string"
        },
        "request": {
          "oneOf": [
            {
              "$ref": "#/$defs/httpMessage"
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/httpMessage"
            },
            {
              "type": "null"
            }
          ]
        },
        "assumption": {
          "type": "object",
          "properties": {
            "evidence_basis": {
              "const": "observed_exchange"
            },
            "consumed_fields": {
              "const": "unknown"
            },
            "provider_check": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "not_checked"
                }
              }
            }
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "grpc_events"
            ]
          },
          {
            "required": [
              "interaction"
            ]
          }
        ]
      }
    },
    "capture": {
      "type": "object",
      "required": [
        "version",
        "testcase",
        "traffic"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "testcase": {
          "type": "object",
          "required": [
            "id",
            "name",
            "started_at"
          ],
          "properties": {
            "identity": {
              "$ref": "#/$defs/testIdentity"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string"
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "schemas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schemaRef"
          }
        },
        "traffic": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flow"
          }
        }
      }
    },
    "bodyRef": {
      "allOf": [
        {
          "$ref": "#/$defs/fileRef"
        },
        {
          "type": "object",
          "required": [
            "flow_id",
            "phase",
            "representation",
            "retained_bytes"
          ],
          "properties": {
            "flow_id": {
              "type": "string",
              "minLength": 1
            },
            "phase": {
              "enum": [
                "request",
                "response"
              ]
            },
            "representation": {
              "enum": [
                "text",
                "bytes"
              ]
            },
            "retained_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "kind"
                ]
              },
              {
                "required": [
                  "message_index"
                ]
              },
              {
                "required": [
                  "status_detail_index"
                ]
              },
              {
                "required": [
                  "event_id"
                ]
              },
              {
                "required": [
                  "payload_name"
                ]
              }
            ]
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "required": [
        "format_version",
        "required_capabilities",
        "run_id",
        "attempt_id",
        "capture"
      ],
      "properties": {
        "format_version": {
          "$ref": "#/$defs/version"
        },
        "required_capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "attempt_id": {
          "$ref": "#/$defs/id"
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "bodies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bodyRef"
          }
        }
      }
    },
    "httpMessage": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "headers": {
          "type": "object"
        },
        "trailers": {
          "type": "object"
        },
        "body": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
