{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle-evidence.schema.json",
  "title": "Wiretap bundle format 3.x",
  "oneOf": [
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/attempt" }
  ],
  "$defs": {
    "version": { "type": "string", "pattern": "^3\\.[0-9]+$" },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "id": { "type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "fileRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "schemaRef": {
      "type": "object",
      "required": ["id", "role", "type", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["sut", "provided", "dependency"] },
        "type": { "type": "string" },
        "protocol": { "type": "string" },
        "services": { "type": "array", "items": { "type": "string" } },
        "acquired_from": { "type": "string" },
        "acquisition": {
          "type": "object",
          "required": ["acquired_at", "normalization_profile"],
          "properties": {
            "acquired_at": { "type": "string", "format": "date-time" },
            "reflection_version": { "enum": ["v1", "v1alpha"] },
            "advertised_services": { "type": "array", "items": { "type": "string" } },
            "excluded_services": { "type": "array", "items": { "type": "string" } },
            "compiler_version": { "type": "string" },
            "normalization_profile": { "type": "string" }
          }
        },
        "source": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["file", "omitted"] },
            "path": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/hash" },
            "format": { "type": "string" }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["format_version", "required_capabilities", "run_id", "revision", "run_state", "started_at", "updated_at", "inventory_scope", "provided_apis", "dependencies", "tests"],
      "properties": {
        "format_version": { "$ref": "#/$defs/version" },
        "required_capabilities": { "$ref": "#/$defs/capabilities" },
        "application": {
          "type": "object",
          "anyOf": [
            { "required": ["name"], "properties": { "name": { "pattern": "\\S" } } },
            { "required": ["id"], "properties": { "id": { "pattern": "\\S" } } }
          ],
          "properties": {
            "name": { "type": "string" },
            "id": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "inventory_scope": { "const": "configured_and_observed" },
        "provided_apis": { "type": "array", "items": { "$ref": "#/$defs/api" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/api" } },
        "run_id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "run_state": { "enum": ["open", "complete", "interrupted"] },
        "started_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "api_id": { "type": "string" },
        "sut_target_kind": { "enum": ["mock", "service", "unknown"] },
        "dependency_kinds": { "type": "object", "additionalProperties": { "enum": ["mock", "service", "unknown"] } },
        "test_source": { "type": "object" },
        "sut_source": { "type": "object" },
        "contracts": { "type": "array", "items": { "$ref": "#/$defs/schemaRef" } },
        "contract_resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["api_id", "role", "protocol", "source", "contract_resolution"],
            "properties": {
              "api_id": { "type": "string", "minLength": 1 },
              "role": { "enum": ["sut", "dependency"] },
              "protocol": { "const": "grpc" },
              "source": { "enum": ["reflection", "proto", "descriptor_set"] },
              "contract_resolution": { "enum": ["pending", "resolved", "failed"] },
              "services": { "type": "array", "items": { "type": "string" } },
              "diagnostic": { "type": "string" }
            }
          }
        },
        "pending_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["attempt_id", "name", "started_at"],
            "properties": {
              "attempt_id": { "$ref": "#/$defs/id" },
              "name": { "type": "string" },
              "started_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/fileRef" },
              { "type": "object", "required": ["attempt_id"], "properties": { "attempt_id": { "$ref": "#/$defs/id" } } }
            ]
          }
        }
      }
    },
    "api": {
      "type": "object",
      "required": ["id", "target_kind", "configured", "protocols", "contracts", "observed_in"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target_kind": { "enum": ["mock", "service", "unknown"] },
        "configured": { "type": "boolean" },
        "protocols": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "observed_in": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "source"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "source": { "$ref": "#/$defs/schemaRef/properties/source" }
            }
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "required": ["id", "protocol"],
      "oneOf": [
        {
          "required": ["interaction"],
          "properties": {
            "interaction": { "$ref": "#/$defs/interaction" },
            "id": { "$ref": "#/$defs/id" },
            "channel": { "const": "" },
            "asset_id": { "const": "" },
            "request": { "type": "null" },
            "response": { "type": "null" }
          }
        },
        {
          "required": ["channel", "request", "response"],
          "properties": { "interaction": { "type": "null" } },
          "if": { "properties": { "protocol": { "const": "grpc" } } },
          "then": { "properties": { "request": { "$ref": "#/$defs/grpcMessage" }, "response": { "$ref": "#/$defs/grpcMessage" } } }
        }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 },
        "channel": { "type": "string" },
        "request": { "type": ["object", "null"] },
        "response": { "type": ["object", "null"] },
        "assumption": {
          "type": "object",
          "properties": {
            "evidence_basis": { "const": "observed_exchange" },
            "consumed_fields": { "const": "unknown" },
            "provider_check": {
              "type": "object",
              "properties": { "status": { "const": "not_checked" } }
            }
          }
        }
      }
    },
    "interaction": {
      "type": "object",
      "required": ["kind", "boundary", "transport", "operation", "capture_state", "events"],
      "properties": {
        "kind": { "enum": ["request_response", "publish", "consume", "stream"] },
        "boundary": {
          "type": "object",
          "required": ["role", "id"],
          "properties": {
            "role": { "enum": ["provided", "dependency"] },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        "transport": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "capture_state": { "enum": ["complete", "incomplete"] },
        "stream_mode": { "enum": ["client", "server", "bidirectional", "subscription"] },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
      },
      "if": { "properties": { "kind": { "const": "stream" } } },
      "then": { "required": ["stream_mode"] },
      "else": { "not": { "required": ["stream_mode"] } }
    },
    "event": {
      "type": "object",
      "required": ["id", "sequence", "direction", "direction_sequence", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 0 },
        "direction": { "enum": ["sent", "received"] },
        "direction_sequence": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["headers", "message", "half_close", "trailers", "complete", "cancel", "error", "ack"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" },
        "payloads": { "type": "array", "items": { "$ref": "#/$defs/eventPayload" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/eventLink" } }
      }
    },
    "eventPayload": {
      "type": "object",
      "required": ["name", "encoding", "availability"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "encoding": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string" },
        "message_type": { "type": "string" },
        "availability": { "enum": ["present", "empty", "null", "redacted", "truncated", "unavailable"] },
        "derived_from": { "type": "string" },
        "transformation": { "type": "string" },
        "writer_schema": { "$ref": "#/$defs/contractLink" },
        "reader_schema": { "$ref": "#/$defs/contractLink" },
        "body": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "availability": { "enum": ["present", "empty", "truncated"] } } },
          "then": { "required": ["body"] },
          "else": { "not": { "required": ["body"] } }
        },
        {
          "if": { "properties": { "availability": { "const": "truncated" } } },
          "then": { "properties": { "body": { "required": ["truncated"], "properties": { "truncated": { "const": true } } } } },
          "else": { "properties": { "body": { "properties": { "truncated": { "const": false } } } } }
        }
      ],
      "dependentRequired": {
        "derived_from": ["transformation"],
        "transformation": ["derived_from"]
      }
    },
    "contractLink": {
      "type": "object",
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "eventLink": {
      "type": "object",
      "required": ["flow_id", "relation", "evidence"],
      "properties": {
        "flow_id": { "type": "string", "minLength": 1 },
        "event_id": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["caused_by", "reply_to", "delivery_of", "acknowledges"] },
        "evidence": { "enum": ["trace", "protocol", "hook", "timing", "unknown"] },
        "run_id": { "$ref": "#/$defs/id" },
        "attempt_id": { "$ref": "#/$defs/id" },
        "attempt_sha256": { "$ref": "#/$defs/hash" }
      },
      "dependentRequired": {
        "run_id": ["attempt_id", "attempt_sha256"],
        "attempt_id": ["run_id", "attempt_sha256"],
        "attempt_sha256": ["run_id", "attempt_id"]
      }
    },
    "grpcMessage": {
      "type": "object",
      "required": ["kind", "procedure", "service", "method", "schema_ref"],
      "if": { "required": ["http_status"] },
      "then": { "required": ["grpc_status"] },
      "properties": {
        "kind": { "const": "grpc" },
        "procedure": { "type": "string", "pattern": "^/[^/]+/[^/]+$" },
        "service": { "type": "string" },
        "method": { "type": "string" },
        "schema_ref": { "type": "string" },
        "stream_kind": { "enum": ["unary", "client_streaming", "server_streaming", "bidirectional", "unknown"] },
        "observed_bytes": { "type": "integer", "minimum": 0 },
        "status_source": { "type": "string" },
        "metadata": { "type": "object" },
        "trailers": { "type": "object" },
        "http_status": { "type": "integer" },
        "grpc_status": { "type": "integer", "minimum": -1, "maximum": 16 },
        "grpc_message": { "type": "string" },
        "capture_truncated": { "type": "boolean" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "type": { "type": "string" },
              "compressed": { "type": "boolean" },
              "redacted": { "type": "boolean" },
              "body": { "type": "object" },
              "wire": { "type": "object" },
              "decode_error": { "type": "string" }
            }
          }
        }
      }
    },
    "rejectionTarget": {
      "type": "object",
      "required": ["key", "schema_id", "operation", "flow_id", "instance_location", "constraint", "expected_statuses"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "schema_id": { "type": "string" },
        "operation": { "type": "string" },
        "flow_id": { "type": "string" },
        "instance_location": { "type": "string" },
        "constraint": { "type": "string" },
        "expected_statuses": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 400, "maximum": 499 } }
      }
    },
    "exploration": {
      "type": "object",
      "required": ["version", "source_run_id", "source_attempt_id", "source_sha256", "mode"],
      "properties": {
        "version": { "const": "wiretap-negative-1" },
        "source_run_id": { "$ref": "#/$defs/id" },
        "source_attempt_id": { "$ref": "#/$defs/id" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mode": { "enum": ["baseline", "rejection"] },
        "target": { "$ref": "#/$defs/rejectionTarget" },
        "catalogue": { "type": "array", "items": { "$ref": "#/$defs/rejectionTarget" } },
        "notes": { "type": "array", "items": { "type": "string" } },
        "request_verified": { "type": "boolean" }
      }
    },
    "capture": {
      "type": "object",
      "required": ["version", "testcase", "traffic"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "exploration": { "$ref": "#/$defs/exploration" },
        "testcase": {
          "type": "object",
          "required": ["id", "name", "started_at"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "type": "string" },
            "started_at": { "type": "string", "format": "date-time" }
          }
        },
        "schemas": { "type": "array", "items": { "$ref": "#/$defs/schemaRef" } },
        "traffic": { "type": "array", "items": { "$ref": "#/$defs/flow" } }
      }
    },
    "bodyRef": {
      "allOf": [
        { "$ref": "#/$defs/fileRef" },
        {
          "type": "object",
          "required": ["flow_id", "phase", "representation", "retained_bytes"],
          "properties": {
            "flow_id": { "type": "string", "minLength": 1 },
            "phase": { "enum": ["request", "response", "event"] },
            "event_id": { "type": "string", "minLength": 1 },
            "payload_name": { "type": "string", "minLength": 1 },
            "representation": { "enum": ["text", "bytes"] },
            "kind": { "enum": ["wire"] },
            "message_index": { "type": "integer", "minimum": 0 },
            "retained_bytes": { "type": "integer", "minimum": 0 }
          },
          "if": { "properties": { "phase": { "const": "event" } } },
          "then": {
            "required": ["event_id", "payload_name"],
            "not": { "anyOf": [{ "required": ["message_index"] }, { "required": ["kind"] }] }
          },
          "else": { "not": { "anyOf": [{ "required": ["event_id"] }, { "required": ["payload_name"] }] } }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "required": ["format_version", "required_capabilities", "run_id", "attempt_id", "capture"],
      "properties": {
        "format_version": { "$ref": "#/$defs/version" },
        "required_capabilities": { "$ref": "#/$defs/capabilities" },
        "run_id": { "$ref": "#/$defs/id" },
        "attempt_id": { "$ref": "#/$defs/id" },
        "capture": { "$ref": "#/$defs/capture" },
        "bodies": { "type": "array", "items": { "$ref": "#/$defs/bodyRef" } }
      }
    }
  }
}
