{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-set.schema.json",
  "title": "Wiretap same-build run set 1.0",
  "type": "object",
  "properties": {
    "run_set_version": {
      "const": "1.0"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "manifest_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_set_version",
    "members"
  ],
  "additionalProperties": false
}
