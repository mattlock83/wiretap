{{- $req := mustFromJSON .Request.Body -}}
{{- $from := coalesce (index $req "from_account") (index .Request.Query "from_account") "acct-unknown" -}}
{{- $to := coalesce (index $req "to_account") (index .Request.Query "to_account") "acct-unknown" -}}
{{- $currency := upper (coalesce (index $req "currency") (index .Request.Query "currency") "usd") -}}
{{- $customer := coalesce (index $req "customer_id") (index .Request.Query "customer_id") "customer-unknown" -}}
{{- $route := trimAll "-" (regexReplaceAll "[^a-z0-9]+" (lower (printf "%v-%v" $from $to)) "-") -}}
{{- $profileName := Name -}}
{{- $profileEmail := Email -}}
{{- setVar "from_account" $from -}}
{{- setVar "to_account" $to -}}
{{- setVar "currency" $currency -}}
{{- setVar "customer_id" $customer -}}
{{- setVar "routing_key" $route -}}
{{- setVar "profile_name" $profileName -}}
{{- setVar "profile_email" $profileEmail -}}
{
  "account_context_loaded": true,
  "from_account": "{{ $from }}",
  "to_account": "{{ $to }}",
  "currency": "{{ $currency }}",
  "customer_id": "{{ $customer }}",
  "routing_key": "{{ $route }}",
  "profile": {
    "name": "{{ $profileName }}",
    "email": "{{ $profileEmail }}"
  },
  "loaded_at": "{{ formatTime "2006-01-02T15:04:05Z07:00" (nowUTC) }}"
}
