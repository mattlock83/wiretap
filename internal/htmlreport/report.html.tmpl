<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'none'; base-uri 'none'; form-action 'none'">
<title>Wiretap · {{.Name}}</title>
<style>
:root{color-scheme:light;--ink:#16263a;--muted:#617187;--line:#dce5ee;--paper:#fff;--wash:#f2f6fa;--teal:#077d76;--blue:#2455b7;--amber:#975f0d;--red:#b02d49}*{box-sizing:border-box}body{margin:0;background:var(--wash);color:var(--ink);font:15px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:var(--blue);text-underline-offset:3px}button,input,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #6abbb5;outline-offset:3px}.shell{max-width:1480px;margin:auto;padding:30px clamp(16px,3vw,48px) 60px}.hero{color:#fff;background:linear-gradient(115deg,#142a45,#087b73);padding:30px 34px;border-radius:22px;box-shadow:0 18px 40px #10283c20}.hero h1{font-size:clamp(27px,3.5vw,43px);line-height:1.15;margin:8px 0 12px;overflow-wrap:anywhere}.hero p{margin:5px 0;opacity:.87}.hero .subtle{color:#d7ebe9;opacity:1}.eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:750}.hero a{color:white}.hero-links{display:flex;gap:18px;flex-wrap:wrap;margin-top:20px;font-size:13px}.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin:22px 0}.metric{background:#fff;border:1px solid var(--line);border-radius:14px;padding:17px}.metric strong{display:block;font-size:28px;line-height:1.15}.metric span{font-size:12px;color:var(--muted)}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin:22px 0}.tabs{display:flex;flex-wrap:wrap;gap:5px;padding:4px;background:#e4ecf5;border-radius:12px}.tabs a{color:#3a4e64;text-decoration:none;padding:8px 11px;font-size:13px;font-weight:650;border-radius:8px}.tabs a[aria-current="page"]{color:#07665f;background:white;box-shadow:0 2px 8px #18324714}.filters{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.filters input,.filters select{border:1px solid #bac9d8;background:#fff;border-radius:9px;padding:8px 10px;color:var(--ink)}.filters input{width:230px}.filters label{font-size:12px;color:var(--muted)}.pane{display:grid;gap:16px;margin-bottom:25px}.pane>h2{font-size:21px;margin:0}.card{background:var(--paper);border:1px solid var(--line);border-radius:15px;padding:22px;box-shadow:0 3px 15px #14304a06;min-width:0}.card h2{font-size:19px;margin:0 0 12px}.card h3{font-size:16px;margin:0}.card p{margin:8px 0}.card-head{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;align-items:flex-start}.subtle{color:var(--muted);font-size:13px}.badge{display:inline-block;border-radius:99px;padding:3px 9px;font-size:12px;font-weight:700;background:#e9eef4;color:#52647a;white-space:nowrap}.badge[data-state="covered"],.badge[data-state="passed"]{background:#e2f3ee;color:#087265}.badge[data-state="not_covered"],.badge[data-state="unknown"],.badge[data-state="unsupported"]{background:#fff1d9;color:var(--amber)}.badge[data-state="failed"]{background:#fce7ec;color:var(--red)}.counts,.links{display:flex;gap:8px 16px;flex-wrap:wrap;font-size:13px}.counts{margin:10px 0}.progress{height:8px;width:100%;margin:13px 0 8px;accent-color:var(--teal);border:0}.progress::-webkit-progress-bar{background:#e6edf4;border-radius:99px}.progress::-webkit-progress-value{background:var(--teal);border-radius:99px}.progress::-moz-progress-bar{background:var(--teal);border-radius:99px}.note{background:#fff8e9;border-left:3px solid #dca43d;padding:9px 13px;border-radius:0 5px 5px 0}.empty{padding:16px 0;color:var(--muted)}details{min-width:0}.operation,.attempt,.condition,.workflow,.source{border:1px solid var(--line);border-radius:11px;background:#fff;margin-top:10px;overflow:hidden}.operation>summary,.attempt>summary,.condition>summary,.workflow>summary,.source>summary,.flow>summary{padding:12px 14px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:14px;background:#f8fafc}.operation[open]>summary,.attempt[open]>summary,.condition[open]>summary,.workflow[open]>summary,.source[open]>summary,.flow[open]>summary{border-bottom:1px solid var(--line)}summary>:first-child{margin-right:auto}summary::after{content:"";height:7px;width:7px;border-right:2px solid #7b8a9d;border-bottom:2px solid #7b8a9d;transform:rotate(-45deg);flex-shrink:0}details[open]>summary::after{transform:rotate(45deg)}summary strong{display:block}summary .subtle{display:block}.detail{padding:13px 16px}.sample{padding:9px 0;border-top:1px solid #e5ecf3}.sample:first-child{border-top:0}.metadata{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:7px 20px;font-size:13px;color:var(--muted);margin:10px 0}.metadata span{overflow-wrap:anywhere}.metadata b{color:#344b63}.flow{border:1px solid var(--line);border-radius:10px;margin:12px 0;background:#f8fafc;overflow:hidden}.flow-body{padding:14px}.messages{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.message{border:1px solid var(--line);border-radius:9px;padding:13px;background:#fff;min-width:0}.message h4{margin:0 0 9px;font-size:14px}.message h5{font-size:12px;text-transform:uppercase;letter-spacing:.06em;margin:15px 0 5px;color:var(--muted)}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#16263b;color:#e8f0fa;padding:12px;border-radius:8px;font:12px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace;max-height:360px;overflow:auto;margin:7px 0}code{font:12px ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere}.break{overflow-wrap:anywhere}.source pre{max-height:550px}.download{border:1px solid #b8cbdc;border-radius:8px;padding:6px 10px;background:#f1f7fb;color:#284d6c;font-size:13px}.no-script{font-size:13px;background:#fff8e9;padding:12px;border-radius:8px}.js-only{display:none}.js .js-only{display:flex}.js [hidden],.js .filter-item[hidden],.js .filter-group[hidden]{display:none!important}.filtered-empty{display:none}.filtered-empty.show{display:block}.footer{font-size:12px;color:var(--muted);margin-top:24px}details:target{outline:2px solid #54a69d;outline-offset:4px}table{width:100%;border-collapse:collapse;font-size:13px;margin:12px 0}th,td{text-align:left;border-bottom:1px solid var(--line);padding:8px 9px;overflow-wrap:anywhere}th{color:var(--muted);font-weight:600}.table-scroll{overflow:auto}.filter-help{font-size:12px;color:var(--muted);margin:0}.workflow-steps{padding-left:20px}.workflow-steps>li{padding:9px 0 14px}.criteria{padding-left:20px}.technical{margin:14px 0;color:var(--muted);font-size:13px}.technical>summary{cursor:pointer;display:list-item}.technical>summary::after{display:none}
@media(max-width:720px){.shell{padding:15px}.hero{padding:24px}.card{padding:17px}.messages{grid-template-columns:1fr}.toolbar{align-items:stretch}.tabs{width:100%}.filters{width:100%}.filters input{flex:1;min-width:140px}.operation>summary,.attempt>summary,.condition>summary{flex-wrap:wrap;align-items:flex-start}.detail{padding:12px}.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-links{gap:12px}}
@media print{.toolbar,.download,.footer{display:none!important}.pane{display:grid!important}details>*,details{display:block!important}.hero{color:#16263a;background:white;box-shadow:none}.card{break-inside:avoid;box-shadow:none}pre{max-height:none;white-space:pre-wrap}.shell{padding:0}.messages{grid-template-columns:1fr}}
</style>
</head>
<body data-wiretap-report="coverage">
<div class="shell">
<header class="hero"><div class="eyebrow">Wiretap · API evidence</div><h1>{{.Name}}</h1><p>Coverage, recorded exchanges, and captured workflows in one place.</p><p class="subtle">Run {{if .RunID}}{{.RunID}}{{else}}identity not recorded{{end}} · {{.RunState}} · revision {{.Revision}} · {{.GeneratedAt}}</p><div class="hero-links"><a href="#provided">Provided APIs</a><a href="#dependencies">Dependencies</a><a href="#tests">Explore test runs</a><a href="#sources">Inspect source files</a></div></header>
<div class="metrics"><div class="metric"><strong>{{.Attempts}}</strong><span>test attempts</span></div><div class="metric"><strong>{{.Passed}}</strong><span>attempts passed</span></div><div class="metric"><strong>{{.Other}}</strong><span>other / unknown outcomes</span></div><div class="metric"><strong>{{.Flows}}</strong><span>captured exchanges</span></div><div class="metric"><strong>{{.Operations}}</strong><span>observed operations</span></div><div class="metric"><strong>{{.Gaps}}</strong><span>uncovered operations</span></div></div>
<div class="toolbar"><nav class="tabs" aria-label="Report sections"><a href="#overview" aria-current="page">Overview</a><a href="#provided">Provided APIs</a><a href="#dependencies">Dependencies</a><a href="#contracts">Contract coverage</a><a href="#tests">Test runs</a><a href="#workflows">Arazzo workflows</a><a href="#sources">Sources</a></nav><div class="filters js-only"><label for="search">Search</label><input id="search" type="search" placeholder="Filter this section"><label for="state-filter">State</label><select id="state-filter"><option value="all">All states</option><option value="attention">Needs attention</option><option value="passed">Passed</option><option value="failed">Failed</option><option value="covered">Covered / observed</option><option value="not_covered">Not covered</option><option value="unknown">Unknown</option><option value="unsupported">Unsupported</option><option value="excluded">Excluded</option></select></div></div>
<noscript><p class="no-script">All sections are visible. Expand rows to inspect evidence. Search, tabs, and source downloads are available when JavaScript is enabled.</p></noscript>
<main>
<section id="overview" class="pane"><h2>Overview</h2><div class="card"><h2>What this run establishes</h2><p><strong>Provided APIs</strong> show operations exercised against the system. <strong>Dependencies</strong> show the outbound calls and replies recorded in its test environment.</p><p>Observed operations include failed attempts. Contract conditions count qualifying evidence under the measurement rules. A passing test, contract validity, and consumer/provider agreement are separate claims.</p><p class="note">This report does not run a compatibility check or establish provider agreement. Use Wiretap’s static consumer/provider check with the matching archives and verified Arazzo exports.</p><p class="subtle">Built only from Wiretap JSON, supplied OpenAPI sources, and Arazzo. This offline view does not fetch sources or execute workflow expressions.</p></div><div class="card"><h2>Coverage and evidence gaps</h2><p>{{.Gaps}} registered operations were not observed. {{.Unknown}} API inventories have an unknown denominator.</p>{{if .HasContracts}}<p>Contract snapshot: <span class="badge" data-state="{{if .ContractComplete}}covered{{else}}unknown{{end}}">{{if .ContractComplete}}complete{{else}}incomplete{{end}}</span></p><p class="subtle">{{.ContractScope}}</p>{{else}}<p class="note">No contract condition measurement is present in the Wiretap JSON. Operation observations do not establish condition coverage.</p>{{end}}</div>{{if .Notes}}<div class="card"><h2>Run diagnostics</h2>{{range .Notes}}<p class="note">{{.}}</p>{{end}}</div>{{end}}</section>
<section id="provided" class="pane"><h2>Provided APIs</h2><div class="card"><p>Observed requests to the system and the returned responses. Expand an operation to find the tests and exchanges that exercised it.</p><p class="subtle">Operation observations are not a count of successful assertions.</p></div>{{range .Provided}}{{template "spec" .}}{{else}}<div class="card empty">No provided API inventory is present. The recorded data does not establish a complete coverage denominator.</div>{{end}}<p class="filtered-empty empty">No provided operations match these filters.</p></section>
<section id="dependencies" class="pane"><h2>Dependencies</h2><div class="card"><p>Outbound calls and the responses supplied to the consumer. Mock responses are assumptions about a provider; service responses are observations in this environment.</p><p class="note">These observations do not establish which response fields the consumer used or agreement with a different provider version.</p></div>{{range .Dependent}}{{template "spec" .}}{{else}}<div class="card empty">No dependency API inventory is present. This does not establish the absence of undeclared dependencies.</div>{{end}}<p class="filtered-empty empty">No dependency operations match these filters.</p></section>
<section id="contracts" class="pane"><h2>Contract coverage</h2><div class="card"><p>Conditions measured against the supplied contracts. <strong>Not covered</strong> means a known condition lacks qualifying evidence. <strong>Unknown</strong> means the evidence cannot decide it. <strong>Unsupported</strong> conditions are outside the measurement rules.</p><p class="subtle">{{.ContractScope}}</p></div>{{range .Contracts}}<div class="card filter-group"><div class="card-head"><div><h3>{{.ID}}</h3><p class="subtle">API {{.APIID}} · {{.Origin}} · target {{.Kind}}</p></div><span class="badge" data-state="{{if .Known}}covered{{else}}unknown{{end}}">{{if .Known}}known denominator{{else}}unknown denominator{{end}}</span></div>{{range .Notes}}<p class="note">{{.}}</p>{{end}}{{if .Counts}}<div class="table-scroll"><table><thead><tr><th>Condition family</th><th>Covered</th><th>Not covered</th><th>Unknown</th><th>Unsupported</th><th>Excluded</th></tr></thead><tbody>{{range .Counts}}<tr><td>{{.Family}}</td><td>{{.Covered}}</td><td>{{.NotCovered}}</td><td>{{.Unknown}}</td><td>{{.Unsupported}}</td><td>{{.Excluded}}</td></tr>{{end}}</tbody></table></div>{{end}}{{range .Violations}}<p class="note"><strong>Contract violation · {{.Operation}}</strong><br>{{.Reason}}{{if .Href}}<br><a href="{{.Href}}">{{.Evidence.TestName}} · {{.Evidence.AttemptID}} / {{.Evidence.FlowID}}</a>{{else}}<br>Evidence reference: {{.Evidence.AttemptID}} / {{.Evidence.FlowID}}{{end}}</p>{{end}}{{range .Targets}}<details id="{{.Anchor}}" class="condition filter-item" data-state="{{.State}}"><summary><span><strong>{{.Operation}}</strong><span class="subtle">{{.Phase}} · {{.Family}} · {{.Condition}}</span></span><span class="badge" data-state="{{.State}}">{{label .State}}</span></summary><div class="detail"><p class="break"><strong>Field:</strong> {{if .FieldPath}}{{.FieldPath}}{{else}}{{.Location}}{{end}}</p>{{if .Reason}}<p class="note">{{.Reason}}</p>{{end}}<p class="subtle">Applies when: {{.AppliesWhen}} · feasibility: {{.Feasibility}}</p>{{range .Evidence}}<div class="sample">{{if .Href}}<a href="{{.Href}}">{{.TestName}} · {{.AttemptID}} / {{.FlowID}}</a>{{else}}<span>{{.TestName}} · {{.AttemptID}} / {{.FlowID}} · evidence not present in this input</span>{{end}}<p class="subtle">Outcome {{.Outcome}} · validation {{.Validation}} · {{.Result}}{{if .Reason}} · {{.Reason}}{{end}}</p>{{if .CaptureIncomplete}}<p class="note">Capture incomplete</p>{{end}}{{if .TransportError}}<p class="note">{{.TransportError}}</p>{{end}}</div>{{else}}<p class="empty">No qualifying evidence is linked to this condition.</p>{{end}}<details class="technical"><summary>Contract provenance</summary><p>Schema location <code>{{.Location}}</code></p><p>Condition key <code>{{.Key}}</code></p></details></div></details>{{else}}<p class="empty">No measured conditions are available for this contract.</p>{{end}}<details class="technical"><summary>Contract revision</summary><code>{{.Revision}}</code></details></div>{{else}}<div class="card empty">No contract condition coverage is present in the input.</div>{{end}}<p class="filtered-empty empty">No contract conditions match these filters.</p></section>
<section id="tests" class="pane"><h2>Test runs</h2><div class="card"><p>Each row is one recorded attempt. Stable test identity, variant, and retry ordinal distinguish executions even when display names match. Expand an attempt for its API coverage and HTTP exchanges.</p></div>{{range .Tests}}<details id="{{.Anchor}}" class="attempt filter-item" data-state="{{.State}}"><summary><span><strong>{{.Name}}</strong><span class="subtle">Attempt {{if .ID}}{{.ID}}{{else}}ID not recorded{{end}}{{if .Ordinal}} · retry ordinal {{.Ordinal}}{{end}}{{if .Variant}} · variant {{.Variant}}{{end}} · {{len .Flows}} exchanges</span></span><span class="badge" data-state="{{.State}}">{{label .State}}</span></summary><div class="detail"><div class="metadata"><span><b>Stable test identity:</b> {{if .Identity}}{{.Identity}}{{else}}not recorded{{end}}</span><span><b>Started:</b> {{.Started}}</span><span><b>Finished:</b> {{.Finished}}</span>{{if .Trace}}<span><b>Trace:</b> {{.Trace}}</span>{{end}}{{if .Tags}}<span><b>Tags:</b> {{range .Tags}}{{.}} {{end}}</span>{{end}}</div>{{if .Coverage}}<h3>Operations exercised by this attempt</h3><div class="links">{{range .Coverage}}<a href="{{.Href}}">{{.Name}}</a>{{end}}</div>{{end}}{{range .Flows}}<details id="{{.Anchor}}" class="flow"><summary><span><strong>{{if .Request.Method}}{{.Request.Method}} {{.Request.URL}}{{else}}Captured {{.Protocol}} interaction{{end}}</strong><span class="subtle">{{.Channel}}{{if .Asset}} · {{.Asset}}{{end}} · flow {{.ID}}</span></span><span class="badge" data-state="{{if or .Error .Incomplete}}unknown{{else}}observed{{end}}">{{if .Response.Status}}HTTP {{.Response.Status}}{{else}}no response status{{end}}</span></summary><div class="flow-body">{{if .Error}}<p class="note">{{.Error}}</p>{{end}}{{if .Incomplete}}<p class="note">Capture incomplete. Retained content does not establish a complete exchange.</p>{{end}}{{if .Redactions}}<p class="note">Recorded redaction rules: {{range .Redactions}}{{.Field}} ({{.Rule}}) {{end}}</p>{{end}}<div class="messages"><div class="message"><h4>Request</h4>{{template "message" .Request}}</div><div class="message"><h4>Response</h4>{{template "message" .Response}}</div></div>{{if .Conditions}}<details class="technical"><summary>Measured contract conditions ({{len .Conditions}})</summary>{{range .Conditions}}<p><a href="{{.Href}}">{{.Name}}</a> <span class="badge" data-state="{{.State}}">{{label .State}}</span></p>{{end}}</details>{{end}}<details class="technical"><summary>Trace and correlation</summary><div class="metadata"><span><b>Protocol:</b> {{.Protocol}}</span><span><b>Trace:</b> {{.Trace}}</span><span><b>Parent flow:</b> {{.Parent}}</span><span><b>Test correlation:</b> {{.Correlation}}</span><span><b>Parent correlation:</b> {{.ParentCorrelation}}</span><span><b>Context source:</b> {{.ContextSource}}</span></div></details></div></details>{{else}}<p class="empty">No exchanges were recorded for this attempt.</p>{{end}}</div></details>{{else}}<div class="card empty">No test attempts are present in this Wiretap JSON.</div>{{end}}<p class="filtered-empty empty">No test attempts match these filters.</p></section>
<section id="workflows" class="pane"><h2>Arazzo workflows</h2><div class="card"><p>Captured JSON/REST workflows, grouped by test attempt and API boundary. Step order is retained from the Arazzo file. Input defaults and expressions are shown as data; they are never executed here.</p><p class="note">Arazzo covers eligible JSON/REST captures. Missing workflows may reflect non-JSON traffic, unsupported capture details, or a boundary outside the export scope. HTTP evidence remains available in Test runs.</p>{{if .ArazzoSources}}<h3>Workflow sources</h3>{{range .ArazzoSources}}<p class="subtle break">{{.Name}} · {{.Type}} · {{.URL}}</p>{{end}}{{end}}</div>{{range .Workflows}}<details class="workflow filter-item" data-state="observed"><summary><span><strong>{{if .Summary}}{{.Summary}}{{else}}{{.ID}}{{end}}</strong><span class="subtle">{{.ID}} · {{.Boundary}} · {{len .Steps}} steps</span></span><span class="badge">captured workflow</span></summary><div class="detail"><p>{{.Description}}</p>{{if .AttemptHref}}<p><a href="{{.AttemptHref}}">Inspect test attempt {{.AttemptID}}</a></p>{{else}}<p class="subtle">Attempt {{.AttemptID}} is not linked to test evidence in this input.</p>{{end}}<details class="technical"><summary>Workflow input defaults</summary><pre>{{.Inputs}}</pre></details><ol class="workflow-steps">{{range .Steps}}<li><strong>{{.ID}}</strong> <span class="break">{{.URL}}</span><p class="subtle break">Operation {{.Operation}}</p>{{if .Href}}<a href="{{.Href}}">Inspect captured flow {{.FlowID}}</a>{{else}}<p class="subtle">Flow {{.FlowID}} is not linked to HTTP evidence in this input.</p>{{end}}{{if .Parameters}}<h4>Parameters</h4><div class="table-scroll"><table><thead><tr><th>Location</th><th>Name</th><th>Value / expression</th></tr></thead><tbody>{{range .Parameters}}<tr><td>{{.In}}</td><td>{{.Name}}</td><td><code>{{json .Value}}</code></td></tr>{{end}}</tbody></table></div>{{end}}{{if .Headers}}<h4>Captured headers</h4><pre>{{.Headers}}</pre>{{end}}{{if .Body}}<h4>Request body</h4><pre>{{.Body}}</pre>{{end}}<h4>Success criteria</h4><ul class="criteria">{{range .Criteria}}<li><code>{{.Condition}}</code></li>{{else}}<li>No success criteria are recorded.</li>{{end}}</ul></li>{{end}}</ol></div></details>{{else}}<div class="card empty">No Arazzo workflows were supplied. Coverage and HTTP evidence remain available from Wiretap JSON.</div>{{end}}<p class="filtered-empty empty">No workflows match these filters.</p></section>
<section id="sources" class="pane"><h2>Sources</h2><div class="card"><p>These are the embedded inputs used to build this report. Source documents, HTTP bodies, headers, URLs, and workflow expressions are untrusted text. Source links are displayed without being opened or fetched.</p><p class="subtle">Downloads contain the embedded text. The HTML is a generated view and is not an input to coverage or compatibility checks.</p></div>{{range .Sources}}<details class="source filter-item" data-state="source"><summary><span><strong>{{.Name}}</strong><span class="subtle">{{.Kind}}</span></span></summary><div class="detail"><button type="button" class="download js-only" data-source="{{.ID}}" data-filename="{{.Name}}">Download {{.Kind}}</button><pre id="{{.ID}}"{{if .OriginalJSON}} data-original-json="{{.OriginalJSON}}"{{end}}>{{.Content}}</pre></div></details>{{end}}<p class="filtered-empty empty">No sources match these filters.</p></section>
</main><p class="footer">Wiretap · Self-contained report. Open locally with no server or network connection. Regenerate from the source inputs to refresh this snapshot.</p>
</div>
<script>
(() => {
  'use strict';
  document.documentElement.classList.add('js');
  const panes = Array.from(document.querySelectorAll('.pane'));
  const tabs = Array.from(document.querySelectorAll('.tabs a'));
  const search = document.getElementById('search');
  const state = document.getElementById('state-filter');
  let active = panes[0];
  function filter() {
    const query = search.value.trim().toLocaleLowerCase();
    const mode = state.value;
    const items = Array.from(active.querySelectorAll('.filter-item'));
    items.forEach(item => {
      const value = item.dataset.state || 'unknown';
      const context = item.closest('.filter-group')?.querySelector('h3')?.textContent || '';
      const matchesState = mode === 'all' || mode === 'attention' && !['covered', 'passed', 'observed', 'source', 'excluded'].includes(value) || value === mode || mode === 'covered' && value === 'observed';
      item.hidden = !matchesState || Boolean(query) && !(item.textContent + ' ' + context).toLocaleLowerCase().includes(query);
      if (!item.hidden && (query || mode !== 'all')) item.open = true;
    });
    active.querySelectorAll('.filter-group').forEach(group => {
      const leaves = Array.from(group.querySelectorAll('.filter-item'));
      group.hidden = leaves.length > 0 && leaves.every(item => item.hidden);
    });
    const empty = active.querySelector('.filtered-empty');
    if (empty) empty.classList.toggle('show', items.length > 0 && items.every(item => item.hidden));
  }
  function activate(pane) {
    if (!pane) return;
    active = pane;
    panes.forEach(item => { item.hidden = item !== pane; });
    tabs.forEach(tab => { if (tab.getAttribute('href') === '#' + pane.id) tab.setAttribute('aria-current', 'page'); else tab.removeAttribute('aria-current'); });
    filter();
  }
  function revealHash() {
    const id = location.hash.slice(1);
    const target = id ? document.getElementById(id) : null;
    if (!target) { activate(active); return; }
    const pane = target.closest('.pane');
    if (!pane) return;
    search.value = ''; state.value = 'all'; activate(pane);
    for (let parent = target; parent && parent !== pane; parent = parent.parentElement) { if (parent.tagName === 'DETAILS') parent.open = true; }
    if (target !== pane) target.scrollIntoView({block:'center'});
  }
  document.addEventListener('click', event => {
    const download = event.target.closest('button[data-source]');
    if (download) {
      const source = document.getElementById(download.dataset.source);
      if (!source) return;
      const text = source.dataset.originalJson ? JSON.parse(source.dataset.originalJson) : source.textContent;
      const url = URL.createObjectURL(new Blob([text], {type:'text/plain;charset=utf-8'}));
      const link = document.createElement('a'); link.href = url;
      link.download = (download.dataset.filename || 'source.json').split(/[\\/]/).pop() || 'source.json';
      document.body.appendChild(link); link.click(); link.remove(); setTimeout(() => URL.revokeObjectURL(url), 1000);
    }
  });
  search.addEventListener('input', filter); state.addEventListener('change', filter);
  window.addEventListener('hashchange', revealHash); revealHash();
})();
</script>
</body></html>
{{define "spec"}}<div id="{{.Anchor}}" class="card filter-group"><div class="card-head"><div><h3>{{.Name}}</h3><p class="subtle break">{{.ID}}{{if .Asset}} · {{.Asset}}{{end}}{{if .Protocol}} · {{.Protocol}}{{end}}</p></div><span class="badge" data-state="{{if .Known}}covered{{else}}unknown{{end}}">{{if .Known}}{{.Observed}} / {{.Total}} operations observed{{else}}{{.Observed}} observed · denominator unknown{{end}}</span></div>{{if .Known}}<progress class="progress" value="{{.Observed}}" max="{{if .Total}}{{.Total}}{{else}}1{{end}}" aria-label="Observed operation coverage">{{.Percent}}%</progress><p class="subtle">{{.Percent}}% of supplied operations exercised; includes failed attempts.</p>{{else}}<p class="note">No complete supplied operation inventory. Observations do not imply complete API coverage.</p>{{end}}{{range .Operations}}<details id="{{.Anchor}}" class="operation filter-item" data-state="{{.State}}"><summary><strong>{{.Name}}</strong><span class="badge" data-state="{{.State}}">{{if eq .State "covered"}}observed{{else}}{{label .State}}{{end}}</span></summary><div class="detail">{{range .Samples}}<div class="sample">{{if .Href}}<a href="{{.Href}}">{{.Name}}</a>{{else}}<span>{{.Name}} · evidence not linked</span>{{end}} <span class="badge" data-state="{{.State}}">{{label .State}}</span><p class="subtle">Attempt {{.AttemptID}} · flow {{.FlowID}}</p></div>{{else}}<p class="empty">No captured exchange exercises this operation.</p>{{end}}</div></details>{{else}}<p class="empty">No operations are present in this inventory.</p>{{end}}<details class="technical"><summary>Source</summary><span class="break">{{.Source}}</span></details></div>{{end}}
{{define "message"}}{{if .Method}}<p class="break"><strong>{{.Method}}</strong> {{.URL}}</p>{{end}}{{if .Status}}<p><strong>HTTP {{.Status}}</strong></p>{{end}}<h5>Headers</h5>{{if .Headers}}<pre>{{.Headers}}</pre>{{else}}<p class="subtle">No headers recorded</p>{{end}}{{if .Trailers}}<h5>Trailers</h5><pre>{{.Trailers}}</pre>{{end}}<h5>Body</h5>{{if .Body}}<pre>{{.Body}}</pre>{{end}}{{if .BodyNote}}<p class="subtle">{{.BodyNote}}</p>{{end}}{{end}}
