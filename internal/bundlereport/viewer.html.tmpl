<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src 'self' data:; connect-src 'none'">
<title>Wiretap · {{.RunID}}</title>
<style>
:root{color-scheme:light;--ink:#172033;--muted:#607087;--line:#dce3ed;--paper:#fff;--wash:#f3f6fb;--teal:#087d77;--blue:#2554bd;--amber:#a7660b;--red:#b12f48}
*{box-sizing:border-box}body{margin:0;background:var(--wash);color:var(--ink);font:15px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}
a{color:var(--blue);text-underline-offset:2px}button,input{font:inherit}button{cursor:pointer}
.shell{max-width:1440px;margin:auto;padding:28px clamp(16px,3vw,48px) 70px}.hero{background:linear-gradient(115deg,#10253c,#0b726f);color:#fff;border-radius:22px;padding:28px 32px;box-shadow:0 16px 35px #17365c24}
.eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;opacity:.75;font-weight:700}.hero h1{font-size:clamp(26px,3vw,40px);line-height:1.15;margin:8px 0}.hero p{margin:0;opacity:.82}.hero a{color:#fff}.hero-links{display:flex;gap:18px;flex-wrap:wrap;margin-top:18px;font-size:13px}
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:20px 0}.metric{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:15px 18px}.metric strong{display:block;font-size:26px;line-height:1.1}.metric span{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.08em}
.toolbar{display:flex;gap:16px;align-items:center;flex-wrap:wrap;justify-content:space-between;margin:20px 0}.tabs{display:flex;gap:5px;background:#e7edf6;border-radius:12px;padding:4px}.tabs button{border:0;background:transparent;color:#34445d;padding:9px 15px;border-radius:9px;font-weight:650}.tabs button.active{background:#fff;box-shadow:0 2px 6px #17203318;color:#0a625e}.search{min-width:min(100%,280px);border:1px solid #bcc9d9;border-radius:10px;padding:9px 12px;background:#fff}
.pane[hidden],.item[hidden]{display:none!important}.pane{display:grid;gap:16px}.card{background:#fff;border:1px solid var(--line);border-radius:15px;padding:20px 22px;box-shadow:0 3px 14px #14284408}.card h2{font-size:19px;margin:0 0 12px}.card h3{font-size:16px;margin:0}.card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;flex-wrap:wrap}.subtle{color:var(--muted);font-size:13px}.badge{display:inline-block;border-radius:99px;padding:3px 9px;background:#e5f3f1;color:#076a64;font-size:12px;font-weight:700}.badge.warn{background:#fff1db;color:#925b08}.badge.fail{background:#fce8ed;color:#a62643}.badge.neutral{background:#ebeff5;color:#4a5a70}
.progress{height:8px;border-radius:99px;background:#e9edf3;overflow:hidden;margin:13px 0 8px}.progress i{display:block;height:100%;background:#0c938a;width:var(--progress)}.operations{display:grid;gap:8px;margin-top:16px}.operation{border:1px solid var(--line);border-radius:10px;background:#f9fbfe}.operation summary,.flow summary{cursor:pointer;padding:10px 12px;display:flex;justify-content:space-between;gap:12px;align-items:center}.operation[open] summary,.flow[open] summary{border-bottom:1px solid var(--line)}.operation-body{padding:10px 13px}.sample{padding:9px 0;border-top:1px solid #e7edf4}.sample:first-child{border-top:0}
.flow{border:1px solid var(--line);border-radius:10px;margin-top:10px;background:#f9fbfe}.flow-body{padding:14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:14px}.message{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px;min-width:0}.message h4{margin:0 0 8px;font-size:14px}.message pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#152235;color:#e7f1ff;border-radius:8px;padding:10px;font-size:12px;max-height:270px;overflow:auto}.message p{margin:6px 0}.note{border-left:3px solid #e6a33b;padding:7px 12px;background:#fff8eb;margin:12px 0}.links{display:flex;gap:14px;flex-wrap:wrap;font-size:13px}.empty{color:var(--muted);padding:16px 0}.footer{margin-top:28px;color:var(--muted);font-size:12px}
@media(max-width:650px){.shell{padding:14px}.hero{padding:22px}.toolbar{align-items:stretch}.tabs{width:100%;justify-content:space-around}.tabs button{padding:8px}.search{width:100%}}
</style>
</head>
<body data-run-id="{{.RunID}}" data-revision="{{.Revision}}">
<div class="shell">
<header class="hero">
<div class="eyebrow">Wiretap capture bundle · {{.State}}</div>
<h1>API evidence and coverage</h1>
<p>Run {{.RunID}} · revision {{.Revision}} · updated {{.GeneratedAt}}</p>
<div class="hero-links">
<a href="../index.md">OKF index</a>
<a href="../coverage.md">Coverage notes</a>
<a href="../evidence/run.json">Run evidence</a>
</div>
</header>
<div class="metrics">
<div class="metric">
<strong>{{.Attempts}}</strong>
<span>test attempts</span>
</div>
<div class="metric">
<strong>{{.Passed}}</strong>
<span>passed</span>
</div>
<div class="metric">
<strong>{{.Failed}}</strong>
<span>other outcomes</span>
</div>{{if .Pending}}<div class="metric">
<strong>{{len .Pending}}</strong>
<span>pending attempts</span>
</div>{{end}}<div class="metric">
<strong>{{.Flows}}</strong>
<span>captured exchanges</span>
</div>
<div class="metric">
<strong>{{.ObservedOperations}}</strong>
<span>observed operations</span>
</div>
</div>
<div class="toolbar">
<nav class="tabs" aria-label="Report sections">
<button type="button" class="active" data-pane="overview" aria-selected="true">Overview</button>
<button type="button" data-pane="apis" aria-selected="false">APIs</button>
<button type="button" data-pane="dependencies" aria-selected="false">Dependencies</button>
<button type="button" data-pane="contracts" aria-selected="false">Conditions</button>
<button type="button" data-pane="tests" aria-selected="false">Tests</button>
</nav>
<input class="search" type="search" placeholder="Filter current section" aria-label="Filter current section">
</div>
<main>
<section class="pane" id="overview">{{if .Pending}}<div class="card">
<h2>Pending attempts</h2>
<p class="note">These attempts started but have no committed capture yet.</p>{{range .Pending}}<p>{{.Name}} · {{.AttemptID}}</p>{{end}}</div>{{end}}<div class="card">
<h2>What this run shows</h2>
<p>Coverage counts declared API operations observed in captured test traffic. A passing observation needs a complete passing attempt. Dependency examples show behaviour used by the consumer; they do not prove which fields it read or that a real provider agrees.</p>
<p class="subtle">This dashboard is a generated view. The JSON evidence, supplied schemas, and retained payloads in this bundle are authoritative.</p>
</div>{{if .Notes}}<div class="card">
<h2>Diagnostics</h2>{{range .Notes}}<p class="note">{{.}}</p>{{end}}</div>{{end}}<div class="card">
<h2>Navigation</h2>
<div class="links">
<a href="../apis/index.md">Provided APIs in OKF</a>
<a href="../dependencies/index.md">Dependencies in OKF</a>
<a href="../tests/index.md">Test attempts in OKF</a>
</div>
</div>
</section>
<section class="pane" id="apis" hidden>{{if .Provided}}{{range .Provided}}{{template "spec" .}}{{end}}{{else}}<div class="card empty">No provided API schemas were supplied. The coverage denominator is unknown.</div>{{end}}</section>
<section class="pane" id="dependencies" hidden>{{if .MockDrafts}}<div class="card"><h2>Inferred mock assumptions</h2><p>OpenAPI drafts from observed mock requests and responses, including failed attempts. These are not provider contracts or validation inputs. Consumer field use and provider agreement remain unknown.</p><div class="links">{{range .MockDrafts}}<a href="{{.URL}}">{{.ID}} — {{.Operations}} operations, {{.Exchanges}} exchanges</a>{{end}}</div></div>{{end}}{{if .Dependent}}<div class="card note">Dependency responses are observed assumptions. Consumer field use and provider agreement remain unknown.</div>{{range .Dependent}}{{template "spec" .}}{{end}}{{else}}<div class="card empty">No dependency schemas were supplied.</div>{{end}}</section>
<section class="pane" id="contracts" hidden>
<div class="card"><h2>Contract conditions</h2><p>Each supplied contract publishes the same stable keys for provider and dependency evidence. A covered key requires a valid message in a complete passing attempt. Failed observations, violations, unsupported rules and unknowns remain separate.</p><p class="note">{{if not .Contracts.Complete}}This run is incomplete. {{end}}Scope is limited to registered contracts. Mock coverage does not establish provider agreement. Combinations are observations, not exhaustive scenario coverage.</p><div class="links"><a href="../contract-coverage.md">OKF condition catalogue</a><a href="../contract-coverage.json">JSON keys, combinations and evidence</a></div></div>
{{range $spec := .Contracts.Specs}}<article class="card"><h2>{{.APIID}} · {{.Origin}} · {{.TargetKind}}</h2><p class="subtle">Schema {{.SchemaID}} · revision {{.Revision}} · {{.Dialect}}</p>{{if not .DenominatorKnown}}<p class="note">Condition denominator is unknown or partial.</p>{{end}}{{range .Notes}}<p>{{.}}</p>{{end}}
{{range $scope, $count := .Counts}}<p class="subtle">{{$scope}}: {{$count.Covered}} covered · {{$count.NotCovered}} not covered · {{$count.Unknown}} unknown · {{$count.Unsupported}} unsupported · {{$count.Excluded}} excluded</p>{{end}}
{{range .Targets}}<details class="operation item" data-search="{{$spec.APIID}} {{$spec.SchemaID}} {{$spec.Origin}} {{$spec.TargetKind}} {{.Operation}} {{.OperationKey}} {{.Phase}} {{.Location}} {{.Family}} {{.Condition}} {{.State}} {{.Key}} {{.Reason}}{{range .Evidence}} {{.TestName}} {{.AttemptID}} {{.FlowID}} {{.InstanceLocation}} {{.Reason}}{{end}}"><summary><span>{{.Operation}} · {{.Phase}} · {{.Family}}: {{.Condition}}</span><span class="badge {{if ne .State "covered"}}neutral{{end}}">{{.State}}</span></summary><div class="operation-body"><p style="overflow-wrap:anywhere">Key: {{.Key}}<br>Schema: {{.Location}}</p><p class="subtle">Feasibility: {{.Feasibility}} · {{.AppliesWhen}}</p>{{if .Reason}}<p class="note">{{.Reason}}</p>{{end}}{{range .Evidence}}<div class="sample"><a href="../{{.Path}}">{{.TestName}} · flow {{.FlowID}}</a> · {{.Result}}<p class="subtle">{{.Phase}} {{.InstanceLocation}} · test {{.Outcome}} · validation {{.Validation}}{{if .CaptureIncomplete}} · capture incomplete{{end}}{{if .TransportError}} · {{.TransportError}}{{end}} {{.Reason}}</p></div>{{end}}</div></details>{{end}}
{{range .Violations}}<p class="note"><a href="../{{.Evidence.Path}}">{{.Evidence.TestName}} · {{.Evidence.FlowID}}</a> · {{.Evidence.Phase}}: {{.Reason}}</p>{{end}}
</article>{{end}}</section>
<section class="pane" id="tests" hidden>{{if .Tests}}{{range .Tests}}<article class="card item" data-search="{{.Search}}">
<div class="card-head">
<div>
<h2>{{.Name}}</h2>
<div class="subtle">Attempt {{.ID}}{{if .TraceID}} · trace {{.TraceID}}{{end}}</div>
</div>
<span class="badge {{if ne .Status "pass"}}fail{{end}}">{{.Status}}</span>
</div>{{if .Incomplete}}<p class="note">Capture incomplete; this attempt cannot count as a complete passing observation.</p>{{end}}{{if .ValidationStatus}}<p class="subtle">Schema validation: {{.ValidationStatus}}</p>{{end}}{{range .Diagnostics}}<p class="note">{{.}}</p>{{end}}<div class="links">
<a href="{{.EvidenceURL}}">Canonical attempt JSON</a>
<a href="{{.MarkdownURL}}">OKF attempt page</a>
</div>{{if .Flows}}{{range .Flows}}<details class="flow">
<summary>
<span>{{.Request.Method}} {{.Request.URL}}</span>
<span class="subtle">{{.Channel}} · HTTP {{.Response.Status}}</span>
</summary>
<div class="operation-body subtle">Flow {{.ID}}{{if .AssetID}} · dependency {{.AssetID}}{{end}}{{if .TraceID}} · trace {{.TraceID}}{{end}}{{if .ParentID}} · parent {{.ParentID}}{{end}}{{if .Correlation}} · test matched by {{.Correlation}}{{end}}{{if .ParentCorrelation}} · parent relationship {{.ParentCorrelation}}{{end}}{{if .ContextSource}} · trace context {{.ContextSource}}{{end}}</div>{{if .Error}}<p class="note">Transport error: {{.Error}}</p>{{end}}<div class="flow-body">{{template "message" .Request}}{{template "message" .Response}}</div>
</details>{{end}}{{else}}<p class="empty">No captured traffic.</p>{{end}}</article>{{end}}{{else}}<div class="card empty">No committed attempts yet.</div>{{end}}</section>
</main>
<p class="footer">Open this file directly from the bundle. No server or external scripts are required. Refresh the bundle views to regenerate this dashboard.</p>
</div>
<script>
(() => {
  const tabs = document.querySelectorAll('[data-pane]');
  const panes = document.querySelectorAll('.pane');
  const search = document.querySelector('.search');
  function filter() {
    const pane = document.querySelector('.pane:not([hidden])');
    if (!pane) return;
    const query = search.value.trim().toLowerCase();
    pane.querySelectorAll('.item').forEach((item) => {
      item.hidden = Boolean(query) && !item.dataset.search.toLowerCase().includes(query);
    });
  }
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    tabs.forEach((item) => {
      item.classList.toggle('active', item === tab);
      item.setAttribute('aria-selected', String(item === tab));
    });
    panes.forEach((pane) => { pane.hidden = pane.id !== tab.dataset.pane; });
    search.value = '';
    filter();
  }));
  search.addEventListener('input', filter);
})();
</script>
</body>
</html>
{{define "spec"}}<article class="card item" data-search="{{.Search}}">
<div class="card-head">
<div>
<h2>{{.Name}}</h2>
<div class="subtle">{{.Kind}} · {{.TargetKind}} target · schema {{.ID}}{{if .AssetID}} · API ID {{.AssetID}}{{end}}</div>
</div>
<span class="badge {{if not .DenominatorKnown}}neutral{{end}}">{{if .DenominatorKnown}}{{.Observed}} / {{.Total}} observed{{else}}denominator unknown{{end}}</span>
</div>{{if .SourceURL}}<div class="links">
<a href="{{.SourceURL}}">Frozen schema</a>
</div>{{end}}{{if .DenominatorKnown}}<div class="progress" role="img" aria-label="{{.Observed}} of {{.Total}} operations observed">
<i style="--progress:{{.Percent}}%">
</i>
</div>
<p class="subtle">{{.Passing}} observed in complete passing attempts · {{.Total}} declared operations</p>{{else}}<p class="subtle">No trustworthy declared-operation denominator is available.</p>{{end}}<div class="operations">{{range .Operations}}<details class="operation">
<summary>
<span>{{.Name}}</span>
<span class="badge {{if eq .State "unobserved"}}neutral{{else if eq .State "observed"}}warn{{end}}">{{.State}}</span>
</summary>
<div class="operation-body">{{if .Samples}}{{range .Samples}}<div class="sample">
<strong>{{.Request}}</strong> → HTTP {{.Response}} · {{.Status}}<div class="links">
<a href="{{.TestURL}}">{{.TestName}}</a>
<a href="{{.EvidenceURL}}">JSON evidence · flow {{.FlowID}}</a>
</div>
</div>{{end}}{{else}}<span class="subtle">No captured example.</span>{{end}}</div>
</details>{{end}}</div>
</article>{{end}}
{{define "message"}}<div class="message">
<h4>{{if .Method}}Request · {{.Method}}{{else}}Response · HTTP {{.Status}}{{end}}</h4>{{if .URL}}<p class="subtle">{{.URL}}</p>{{end}}{{if .Headers}}<strong>Headers</strong>
<pre>{{.Headers}}</pre>{{end}}{{if .Trailers}}<strong>Trailers</strong>
<pre>{{.Trailers}}</pre>{{end}}{{if .BodyNote}}<p class="note">{{.BodyNote}}</p>{{end}}{{if .Body}}<strong>Body preview</strong>
<pre>{{.Body}}</pre>{{end}}{{if .AttachmentURL}}<a href="{{.AttachmentURL}}">Retained body attachment</a>{{end}}</div>{{end}}
