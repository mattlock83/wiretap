{
  "name": "@wiretap/sdk",
  "version": "0.1.0",
  "description": "Test lifecycle and tracing SDK for Wiretap boundary capture",
  "main": "src/index.js",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js && jest --config jest.config.cjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "jest-each": "^30.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/mocha": "^10.0.10",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "mocha-11": "npm:mocha@^11.7.5"
  },
  "peerDependencies": {
    "@playwright/test": "^1.64.1",
    "jest-environment-node": "^29.7.0 || ^30.0.0",
    "mocha": "^11.7.5 || ^12.0.0"
  },
  "peerDependenciesMeta": {
    "jest-environment-node": {
      "optional": true
    },
    "mocha": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "types": "src/index.d.ts",
  "files": [
    "src/",
    "tracing.js",
    "tracing.d.ts",
    "jest.js",
    "jest.d.ts",
    "jest-environment.js",
    "LICENSE",
    "README.md",
    "mocha.js",
    "mocha.d.ts",
    "playwright.js",
    "playwright.d.ts",
    "docs/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattlock83/wiretap.git",
    "directory": "sdk/js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./tracing": {
      "types": "./tracing.d.ts",
      "require": "./tracing.js",
      "default": "./tracing.js"
    },
    "./jest": {
      "types": "./jest.d.ts",
      "require": "./jest.js",
      "default": "./jest.js"
    },
    "./jest-environment": "./jest-environment.js",
    "./package.json": "./package.json",
    "./managed-runtime": {
      "types": "./src/managed-runtime.d.ts",
      "require": "./src/managed-runtime.js",
      "default": "./src/managed-runtime.js"
    },
    "./mocha": {
      "types": "./mocha.d.ts",
      "require": "./mocha.js",
      "default": "./mocha.js"
    },
    "./playwright": {
      "types": "./playwright.d.ts",
      "require": "./playwright.js",
      "default": "./playwright.js"
    }
  },
  "overrides": {
    "mocha-11": {
      "diff": "^8.0.4",
      "serialize-javascript": "^7.1.4"
    }
  }
}
