{
  "name": "@wiretap/sdk",
  "version": "0.1.0",
  "description": "Jest lifecycle and tracing SDK for Wiretap HTTP capture",
  "main": "jest.js",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js && jest --config jest.config.cjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  },
  "peerDependencies": {
    "jest-environment-node": "^29.7.0 || ^30.0.0"
  },
  "peerDependenciesMeta": {
    "jest-environment-node": {
      "optional": true
    }
  },
  "types": "jest.d.ts",
  "files": [
    "src/",
    "tracing.js",
    "tracing.d.ts",
    "jest.js",
    "jest.d.ts",
    "jest-environment.js",
    "LICENSE",
    "README.md",
    "docs/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattlock83/wiretap.git",
    "directory": "sdk/js"
  },
  "exports": {
    ".": {
      "types": "./jest.d.ts",
      "require": "./jest.js",
      "default": "./jest.js"
    },
    "./tracing": {
      "types": "./tracing.d.ts",
      "require": "./tracing.js",
      "default": "./tracing.js"
    },
    "./jest": {
      "types": "./jest.d.ts",
      "require": "./jest.js",
      "default": "./jest.js"
    },
    "./jest-environment": "./jest-environment.js",
    "./package.json": "./package.json"
  }
}
